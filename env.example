# ===== Database =====
DATABASE_URL=postgresql://user:password@host/dbname

# ===== ValueCommerce =====
# 管理画面 > 設定 > レポートAPI認証キーの取得 から発行
VC_API_TOKEN_KEY=
VC_API_SECRET=

# ===== A8.net =====
A8_LOGIN_ID=
A8_PASSWORD=

# ===== もしもアフィリエイト =====
MOSHIMO_LOGIN_ID=
MOSHIMO_PASSWORD=

# ===== LINE Messaging API =====
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO_USER_ID=

# ===== 実行制御 =====
TZ=Asia/Tokyo
# true にするとDB書き込みとLINE通知を行わない（開発時は必ずtrue）
DRY_RUN=true
